// The site's 404 Worker (worker.ts). One Worker per hostname, so each can be tried and removed on its own:
//   npx wrangler deploy -c cloudflare/site-404/wrangler.jsonc --env staging-test
// NOT DEPLOYED. Read docs/setup.md, "The 404 page", first.
{
  "name": "vault-site-404",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // The staging bucket's test address: nobody visits it. Try here first.
    "staging-test": {
      "routes": [{ "pattern": "r2-site.vaultlearninggames-staging.org/*", "zone_name": "vaultlearninggames-staging.org" }]
    },
    "staging": {
      "routes": [{ "pattern": "vaultlearninggames-staging.org/*", "zone_name": "vaultlearninggames-staging.org" }]
    },
    // Production's test address today; add "vaultlearninggames.org/*" when the real domain moves to R2.
    "production": {
      "routes": [{ "pattern": "r2-site.vaultlearninggames.org/*", "zone_name": "vaultlearninggames.org" }]
    }
  }
}
