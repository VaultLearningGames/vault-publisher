{
  "name": "vault-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Publishes game builds to the Vault Learning Games CDN (Cloudflare R2), authorized by GitHub Actions OIDC.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
