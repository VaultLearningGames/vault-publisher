{
  "name": "vault-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "The Vault Studio Portal: publishes game builds to the Vault Learning Games CDN (Cloudflare R2), and previews listings and blog posts with the Vault website's source (VaultLearningGames/vault-site).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "site:audit": "node scripts/check-site.ts",
    "import:medium": "node scripts/import-medium-fielddaylab.ts",
    "import:legacy-games": "node scripts/import-legacy-games.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nspell": "^2.1.6",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
