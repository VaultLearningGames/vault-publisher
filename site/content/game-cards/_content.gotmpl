{{/*
  The rest of the Squarespace /game-cards collection:
    /game-cards/<card id>              each game's Game Card: not a page here but a 301 to the game's page, listed
                                       in card-redirects.json (layouts/index.cardredirects.json) for the hosting.
    /game-cards/category/<Grades X>    the collection filtered by grade band or by studio ("Dev: <maker>"), and
    /game-cards/tag/<Subject: X>       by subject or topic ("Topic: X"), as in Squarespace's sitemap.
  Filter pages are generated from the catalog, so new values get pages too.
*/}}
{{- $cats := slice }}{{ $tags := slice -}}
{{- range hugo.Data.catalog.games -}}
  {{- range .grades }}{{ $cats = $cats | append . }}{{ end -}}
  {{- range .makers }}{{ $cats = $cats | append (printf "Dev: %s" .) }}{{ end -}}
  {{- range .subjects }}{{ if and . (ne . "null") }}{{ $tags = $tags | append (printf "Subject: %s" .) }}{{ end }}{{ end -}}
  {{- range .topics }}{{ if and . (ne . "null") }}{{ $tags = $tags | append (printf "Topic: %s" .) }}{{ end }}{{ end -}}
{{- end -}}
{{- with hugo.Data.squarespace.filters }}{{ $cats = $cats | append .category }}{{ $tags = $tags | append .tag }}{{ end -}}
{{- range $kind, $vals := dict "category" ($cats | uniq) "tag" ($tags | uniq) -}}
  {{- range $vals -}}
    {{- /* Hugo can't write "Dev:+Field+Day+Lab" as a folder name, so these are built under /game-cards/_filters/ and
           scripts/squarespace-paths.mjs (run by `npm run site:build`) moves each to the folder named after its
           Squarespace address with %3A as ":" and %2F as "/", "+" kept. */ -}}
    {{- $seg := replace . " " "+" -}}
    {{- $n := printf "%s-%s" $kind (md5 . | truncate 10 "") -}}
    {{- $.AddPage (dict "path" $n "title" . "kind" "page" "type" "game-cards" "url" (printf "/game-cards/_filters/%s/" $n)
          "params" (dict "filter_kind" $kind "filter_value" . "sq_path" (printf "game-cards/%s/%s" $kind $seg) "sitemap" (dict "disable" true))) -}}
  {{- end -}}
{{- end -}}
