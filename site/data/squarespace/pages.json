    {
     "type": "text",
     "html": "<h1 style=\"text-align:center;white-space:pre-wrap;\">who made this?</h1>",
     "id": "1807d1ed",
     "aream": "2/2/4/10",
     "aread": "3/8/5/20",
     "zm": "2",
     "zd": "2",
     "jm": "flex-start",
     "jd": "center",
     "am": "flex-start",
     "ad": "center"
    },
    {
     "type": "text",
     "html": "<p class=\"\" style=\"white-space:pre-wrap;\">The Vault is created by <a href=\"http://fielddaylab.wisc.edu\" target=\"_blank\">Field Day Lab</a>, based at the University of Wisconsin. With decades of experience designing learning games, we know what it takes to make a game that works. </p><p class=\"\" style=\"white-space:pre-wrap;\">The games on this site have been created by many amazing studios. </p><p class=\"\" style=\"white-space:pre-wrap;\"></p>",
     "id": "88_43331",
     "aream": "4/2/11/10",
     "aread": "6/8/12/20",
     "zm": "3",
     "zd": "3",
     "jm": "flex-start",
     "jd": "flex-start",
